<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hazly — Managed IT Services</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #f5f2ef;
    --bg-warm: #eee9e3;
    --bg-card: #ffffff;
    --bg-dark: #2c2825;
    --text-primary: #2c2825;
    --text-secondary: #6e6560;
    --text-muted: #9e9590;
    --text-on-dark: #f5f2ef;
    --text-on-dark-muted: #b5aea8;
    --orange: #e8834a;
    --orange-hover: #d6722e;
    --orange-light: #fce8db;
    --orange-glow: rgba(232, 131, 74, 0.25);
    --warm-100: #f5f2ef;
    --warm-200: #eee9e3;
    --warm-300: #ddd5cc;
    --warm-400: #c4b9ad;
    --warm-500: #9e9590;
    --warm-600: #6e6560;
    --warm-700: #4a4340;
    --warm-800: #3a3530;
    --warm-900: #2c2825;
    --radius-sm: 14px;
    --radius-md: 20px;
    --radius-lg: 28px;
    --radius-xl: 36px;
    --radius-pill: 100px;
    --font-display: 'Outfit', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --shadow-soft: 0 4px 30px rgba(44, 40, 37, 0.06);
    --shadow-hover: 0 12px 40px rgba(44, 40, 37, 0.12);
    --max-width: 1180px;
  }

  html { scroll-behavior: smooth; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text-primary);
    line-height: 1.65;
    overflow-x: hidden;
    -webkit-font-smoothing: antialiased;
  }

  /* ——— ANIMATIONS ——— */
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(30px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes float {
    0%, 100% { transform: translateY(0px); }
    50% { transform: translateY(-12px); }
  }
  @keyframes blob {
    0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    25% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
    50% { border-radius: 50% 60% 30% 60% / 30% 60% 70% 40%; }
    75% { border-radius: 60% 40% 60% 30% / 60% 40% 30% 70%; }
  }
  @keyframes pulse-ring {
    0% { transform: scale(1); opacity: 0.4; }
    100% { transform: scale(1.5); opacity: 0; }
  }
  .anim { opacity: 0; transform: translateY(30px); transition: all 0.7s cubic-bezier(0.22, 1, 0.36, 1); }
  .anim.visible { opacity: 1; transform: translateY(0); }
  .anim-d1 { transition-delay: 0.1s; }
  .anim-d2 { transition-delay: 0.2s; }
  .anim-d3 { transition-delay: 0.3s; }

  /* ——— NAV ——— */
  nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: 100;
    padding: 18px 40px;
    display: flex; align-items: center; justify-content: space-between;
    background: rgba(245, 242, 239, 0.85);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
    transition: box-shadow 0.3s, padding 0.3s;
  }
  nav.scrolled {
    box-shadow: 0 2px 24px rgba(44,40,37,0.07);
    padding: 12px 40px;
  }
  .logo {
    font-family: var(--font-display);
    font-weight: 800; font-size: 30px;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.5px;
  }
  .logo span { color: var(--orange); text-shadow: 0 0 6px rgba(232, 131, 74, 0.25); }

  .nav-links { display: flex; gap: 36px; align-items: center; list-style: none; }
  .nav-links a {
    text-decoration: none; color: var(--text-secondary);
    font-weight: 500; font-size: 15px;
    transition: color 0.25s;
    position: relative;
  }
  .nav-links a::after {
    content: ''; position: absolute; bottom: -4px; left: 0;
    width: 0; height: 2px; background: var(--orange);
    border-radius: 2px; transition: width 0.3s;
  }
  .nav-links a:hover { color: var(--text-primary); }
  .nav-links a:hover::after { width: 100%; }
  .nav-links .btn-primary { color: #fff; }
  .nav-links .btn-primary:hover { color: var(--text-primary); }
  .nav-links .btn-primary::after { display: none; }

  .hamburger { display: none; background: none; border: none; cursor: pointer; padding: 4px; }
  .hamburger svg { width: 28px; height: 28px; color: var(--text-primary); }

  /* ——— MOBILE NAV ——— */
  .mobile-menu {
    display: none;
    position: fixed; top: 0; left: 0; right: 0; bottom: 0;
    background: rgba(245, 242, 239, 0.97);
    backdrop-filter: blur(20px);
    z-index: 99;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 32px;
  }
  .mobile-menu.open { display: flex; }
  .mobile-menu a {
    font-family: var(--font-display);
    font-size: 24px; font-weight: 600;
    text-decoration: none;
    color: var(--text-primary);
    transition: color 0.2s;
  }
  .mobile-menu a:hover { color: var(--orange); }
  .mobile-close {
    position: absolute; top: 20px; right: 20px;
    background: none; border: none; cursor: pointer;
  }
  .mobile-close svg { width: 32px; height: 32px; color: var(--text-primary); }

  /* ——— BUTTONS ——— */
  .btn {
    display: inline-flex; align-items: center; gap: 8px;
    padding: 13px 30px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
    font-weight: 600; font-size: 15px;
    text-decoration: none; border: none; cursor: pointer;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .btn-primary { background: var(--orange); color: #fff; }
  .btn-primary:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(232, 131, 74, 0.45);
  }
  .btn-outline {
    background: transparent; color: var(--text-primary);
    border: 2px solid var(--warm-300);
  }
  .btn-outline:hover {
    border-color: var(--orange);
    color: var(--orange);
    transform: translateY(-2px);
  }
  .btn-large { padding: 17px 40px; font-size: 17px; }
  .btn-ghost-white { background: transparent; color: #fff; border: 2px solid rgba(255,255,255,0.3); }
  .btn-ghost-white:hover {
    border-color: #fff;
    background: rgba(255,255,255,0.1);
    transform: translateY(-2px);
  }

  section { padding: 100px 40px; }
  .section-inner { max-width: var(--max-width); margin: 0 auto; }

  /* ——— HERO ——— */
  .hero {
    min-height: 100vh;
    display: flex; align-items: center;
    padding: 140px 40px 100px;
    position: relative;
    overflow: hidden;
  }
  .hero-bg-blob {
    position: absolute;
    width: 500px; height: 500px;
    background: var(--orange-light);
    opacity: 0.5;
    animation: blob 12s ease-in-out infinite;
    filter: blur(60px);
  }
  .hero-bg-blob:nth-child(1) { top: -100px; right: -100px; }
  .hero-bg-blob:nth-child(2) {
    bottom: -150px; left: -100px;
    width: 400px; height: 400px;
    background: var(--warm-300);
    animation-delay: -4s;
    opacity: 0.4;
  }
  .hero-inner {
    max-width: var(--max-width); margin: 0 auto; width: 100%;
    display: grid; grid-template-columns: 1.1fr 0.9fr; gap: 60px; align-items: center;
    position: relative; z-index: 1;
  }
  .hero h1 {
    font-family: var(--font-display);
    font-size: clamp(40px, 5vw, 64px);
    font-weight: 800; line-height: 1.1;
    letter-spacing: -1.5px;
    margin-bottom: 20px;
    animation: fadeUp 0.6s ease 0.1s both;
  }
  .hero h1 em {
    font-style: normal;
    color: var(--orange);
    text-shadow: 0 0 6px rgba(232, 131, 74, 0.25);
  }
  .hero p {
    font-size: 18px; color: var(--text-secondary);
    max-width: 480px; margin-bottom: 36px; line-height: 1.7;
    animation: fadeUp 0.6s ease 0.2s both;
  }
  .hero-buttons {
    display: flex; gap: 16px; flex-wrap: wrap;
    animation: fadeUp 0.6s ease 0.3s both;
  }

  /* Hero Visual */
  .hero-visual {
    position: relative;
    animation: fadeUp 0.8s ease 0.3s both;
  }
  .hero-card {
    background: var(--bg-card);
    border-radius: var(--radius-xl);
    padding: 36px;
    box-shadow: var(--shadow-soft);
    position: relative;
  }
  .hero-card-header {
    display: flex; align-items: center; gap: 14px;
    margin-bottom: 28px;
  }
  .hero-card-icon {
    width: 48px; height: 48px;
    background: var(--orange-light);
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 22px;
  }
  .hero-card-title {
    font-family: var(--font-display);
    font-weight: 700; font-size: 18px;
  }
  .hero-card-subtitle {
    font-size: 13px; color: var(--text-muted);
    white-space: nowrap;
  }
  .status-rows { display: flex; flex-direction: column; gap: 14px; }
  .status-row {
    display: flex; align-items: center; justify-content: space-between;
    gap: 16px;
    padding: 14px 18px;
    background: var(--warm-100);
    border-radius: var(--radius-md);
    transition: transform 0.2s;
  }
  .status-row:hover { transform: translateX(4px); }
  .status-label { font-weight: 500; font-size: 14px; display: flex; align-items: center; gap: 10px; white-space: nowrap; }
  .status-dot {
    width: 10px; height: 10px; min-width: 10px; border-radius: 50%;
    flex-shrink: 0;
  }
  .status-dot.green { background: #aaff00; border: 1px solid #2c2825; }
  .status-dot.blue { background: #00d4ff; border: 1px solid #2c2825; }
  .status-dot.purple { background: #d400ff; border: 1px solid #2c2825; }
  .status-badge {
    font-size: 12px; font-weight: 600;
    padding: 4px 12px;
    border-radius: var(--radius-pill);
    font-family: var(--font-display);
  }
  .badge-green { background: #e3f5e6; color: #4a9b58; }
  .badge-blue { background: #dfedf5; color: #5a94b5; }
  .badge-purple { background: #f5e3fc; color: #a020d0; }

  /* Floating pills */
  .float-pill {
    position: absolute;
    background: var(--bg-card);
    border-radius: var(--radius-pill);
    padding: 10px 18px;
    box-shadow: var(--shadow-hover);
    font-family: var(--font-display);
    font-weight: 600; font-size: 13px;
    display: flex; align-items: center; gap: 8px;
    animation: float 4s ease-in-out infinite;
    white-space: nowrap;
  }
  .float-pill.fp1 { top: -20px; right: -14px; animation-delay: -1s; }
  .float-pill.fp2 { bottom: -35px; left: -17px; animation-delay: -2.5s; }
  .float-pill-icon {
    width: 28px; height: 28px;
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    font-size: 14px;
  }

  /* ——— SERVICES ——— */
  .services { background: var(--bg-warm); }
  .section-header {
    text-align: center;
    max-width: 600px; margin: 0 auto 64px;
  }
  .section-tag {
    display: inline-flex;
    font-family: var(--font-display);
    font-weight: 600; font-size: 13px;
    color: var(--orange);
    text-transform: uppercase;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  .section-header h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 44px);
    font-weight: 800; line-height: 1.15;
    letter-spacing: -1px;
    margin-bottom: 16px;
  }
  .section-header p {
    font-size: 17px; color: var(--text-secondary); line-height: 1.7;
  }

  .services-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 24px;
  }
  .service-card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 36px;
    box-shadow: var(--shadow-soft);
    transition: all 0.35s cubic-bezier(0.22, 1, 0.36, 1);
    position: relative;
    overflow: hidden;
  }
  .service-card::before {
    content: '';
    position: absolute; top: 0; left: 0; right: 0;
    height: 4px;
    background: var(--orange);
    border-radius: 4px 4px 0 0;
    opacity: 0;
    transition: opacity 0.3s;
  }
  .service-card:hover {
    transform: translateY(-6px);
    box-shadow: var(--shadow-hover);
  }
  .service-card:hover::before { opacity: 1; }
  .service-icon {
    width: 56px; height: 56px;
    background: var(--orange-light);
    border-radius: var(--radius-md);
    display: flex; align-items: center; justify-content: center;
    font-size: 26px;
    margin-bottom: 22px;
    transition: transform 0.3s;
  }
  .service-card:hover .service-icon { transform: scale(1.08) rotate(-3deg); }
  .service-card h3 {
    font-family: var(--font-display);
    font-weight: 700; font-size: 20px;
    margin-bottom: 10px;
  }
  .service-card p {
    font-size: 15px; color: var(--text-secondary); line-height: 1.65;
  }

  /* ——— CTA ——— */
  .cta {
    background: var(--bg-dark);
    position: relative;
    overflow: hidden;
  }
  .cta-inner {
    max-width: var(--max-width); margin: 0 auto;
    text-align: center;
    position: relative; z-index: 1;
  }
  .cta-blob {
    position: absolute;
    width: 400px; height: 400px;
    background: var(--orange);
    border-radius: 50%;
    opacity: 0.06;
    filter: blur(80px);
  }
  .cta-blob:nth-child(1) { top: -100px; left: -100px; }
  .cta-blob:nth-child(2) { bottom: -150px; right: -100px; }
  .cta h2 {
    font-family: var(--font-display);
    font-size: clamp(32px, 4vw, 48px);
    font-weight: 800;
    color: var(--text-on-dark);
    line-height: 1.15;
    margin-bottom: 16px;
    letter-spacing: -1px;
  }
  .cta h2 em { font-style: normal; color: var(--orange); }
  .cta p {
    font-size: 18px;
    color: var(--text-on-dark-muted);
    max-width: 520px; margin: 0 auto 36px;
    line-height: 1.7;
  }

  /* ——— FOOTER ——— */
  footer {
    background: var(--bg-dark);
    border-top: 1px solid rgba(255,255,255,0.06);
    padding: 36px 40px;
  }
  .footer-inner {
    max-width: var(--max-width); margin: 0 auto;
    display: flex; justify-content: space-between; align-items: center;
    flex-wrap: wrap; gap: 12px;
  }
  .footer-inner p {
    font-size: 13px; color: var(--text-on-dark-muted);
  }
  .footer-socials { display: flex; gap: 16px; }
  .footer-socials a {
    width: 36px; height: 36px;
    background: rgba(255,255,255,0.06);
    border-radius: 50%;
    display: flex; align-items: center; justify-content: center;
    text-decoration: none;
    transition: all 0.3s;
  }
  .footer-socials a:hover {
    background: var(--orange);
    transform: translateY(-2px);
  }
  .footer-socials svg { width: 16px; height: 16px; fill: var(--text-on-dark-muted); }
  .footer-socials a:hover svg { fill: #fff; }

  /* ——— RESPONSIVE ——— */
  @media (max-width: 960px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero p { margin-left: auto; margin-right: auto; }
    .hero-buttons { justify-content: center; }
    .hero-visual { max-width: 460px; margin: 0 auto; }
    .services-grid { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 640px) {
    section { padding: 72px 20px; }
    nav { padding: 14px 20px; }
    .nav-links { display: none; }
    .hamburger { display: block; }
    .services-grid { grid-template-columns: 1fr; }
    .hero { padding-top: 110px; }
  }
</style>
</head>
