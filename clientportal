<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Hazly — Client Portal</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&family=DM+Sans:ital,opsz,wght@0,9..40,300;0,9..40,400;0,9..40,500;0,9..40,600;1,9..40,400&display=swap" rel="stylesheet">
<style>
  *, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

  :root {
    --bg: #f5f2ef;
    --bg-warm: #eee9e3;
    --bg-card: #ffffff;
    --bg-dark: #2c2825;
    --text-primary: #2c2825;
    --text-secondary: #6e6560;
    --text-muted: #9e9590;
    --orange: #e8834a;
    --orange-hover: #d6722e;
    --orange-light: #fce8db;
    --orange-glow: rgba(232, 131, 74, 0.25);
    --warm-200: #eee9e3;
    --warm-300: #ddd5cc;
    --radius-sm: 14px;
    --radius-md: 20px;
    --radius-lg: 28px;
    --radius-pill: 100px;
    --font-display: 'Outfit', sans-serif;
    --font-body: 'DM Sans', sans-serif;
    --shadow-soft: 0 4px 30px rgba(44, 40, 37, 0.06);
    --shadow-hover: 0 12px 40px rgba(44, 40, 37, 0.12);
  }

  html, body { height: 100%; }

  body {
    font-family: var(--font-body);
    background: var(--bg);
    color: var(--text-primary);
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 20px;
    position: relative;
    overflow: hidden;
  }

  @keyframes blob {
    0%, 100% { border-radius: 60% 40% 30% 70% / 60% 30% 70% 40%; }
    25% { border-radius: 30% 60% 70% 40% / 50% 60% 30% 60%; }
    50% { border-radius: 50% 60% 30% 60% / 30% 60% 70% 40%; }
    75% { border-radius: 60% 40% 60% 30% / 60% 40% 30% 70%; }
  }
  @keyframes fadeUp {
    from { opacity: 0; transform: translateY(20px); }
    to { opacity: 1; transform: translateY(0); }
  }
  @keyframes shake {
    0%, 100% { transform: translateX(0); }
    20% { transform: translateX(-8px); }
    40% { transform: translateX(8px); }
    60% { transform: translateX(-6px); }
    80% { transform: translateX(6px); }
  }

  .bg-blob {
    position: absolute;
    width: 400px; height: 400px;
    background: var(--orange-light);
    opacity: 0.4;
    animation: blob 12s ease-in-out infinite;
    filter: blur(60px);
    z-index: 0;
  }
  .bg-blob:nth-child(1) { top: -120px; right: -80px; }
  .bg-blob:nth-child(2) {
    bottom: -120px; left: -80px;
    width: 350px; height: 350px;
    background: var(--warm-300);
    animation-delay: -4s;
    opacity: 0.35;
  }

  .login-card {
    background: var(--bg-card);
    border-radius: var(--radius-lg);
    padding: 48px 40px;
    width: 100%;
    max-width: 420px;
    box-shadow: var(--shadow-hover);
    position: relative;
    z-index: 1;
    animation: fadeUp 0.6s ease both;
  }

  .login-header {
    text-align: center;
    margin-bottom: 36px;
  }

  .logo {
    font-family: var(--font-display);
    font-weight: 800; font-size: 32px;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: -0.5px;
    display: inline-block;
    margin-bottom: 8px;
  }
  .logo span { color: var(--orange); text-shadow: 0 0 6px rgba(232, 131, 74, 0.25); }

  .login-header p {
    font-size: 15px;
    color: var(--text-muted);
    font-weight: 500;
  }

  .form-group {
    margin-bottom: 20px;
  }

  .form-group label {
    display: block;
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 14px;
    color: var(--text-primary);
    margin-bottom: 8px;
  }

  .form-group input {
    width: 100%;
    padding: 14px 18px;
    border: 2px solid var(--warm-200);
    border-radius: var(--radius-sm);
    font-family: var(--font-body);
    font-size: 15px;
    color: var(--text-primary);
    background: var(--bg);
    transition: border-color 0.25s, box-shadow 0.25s;
    outline: none;
  }

  .form-group input::placeholder {
    color: var(--text-muted);
  }

  .form-group input:focus {
    border-color: var(--orange);
    box-shadow: 0 0 0 3px var(--orange-glow);
  }

  .form-group input.error {
    border-color: #e05a4f;
    box-shadow: 0 0 0 3px rgba(224, 90, 79, 0.15);
  }

  .form-options {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 28px;
  }

  .remember-me {
    display: flex;
    align-items: center;
    gap: 8px;
    cursor: pointer;
  }

  .remember-me input[type="checkbox"] {
    width: 18px; height: 18px;
    accent-color: var(--orange);
    cursor: pointer;
  }

  .remember-me span {
    font-size: 14px;
    color: var(--text-secondary);
  }

  .forgot-link {
    font-size: 14px;
    color: var(--orange);
    text-decoration: none;
    font-weight: 500;
    transition: color 0.2s;
  }
  .forgot-link:hover { color: var(--orange-hover); }

  .btn-login {
    width: 100%;
    padding: 16px;
    border: none;
    border-radius: var(--radius-pill);
    background: var(--orange);
    color: #fff;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 16px;
    cursor: pointer;
    transition: all 0.3s cubic-bezier(0.22, 1, 0.36, 1);
  }

  .btn-login:hover {
    background: var(--orange-hover);
    transform: translateY(-2px);
    box-shadow: 0 8px 28px rgba(232, 131, 74, 0.45);
  }

  .btn-login:active {
    transform: translateY(0);
  }

  .error-message {
    text-align: center;
    margin-top: 20px;
    font-size: 14px;
    color: #e05a4f;
    font-weight: 500;
    display: none;
  }

  .error-message.show {
    display: block;
    animation: fadeUp 0.3s ease both;
  }

  .login-card.shake {
    animation: shake 0.4s ease;
  }

  .back-link {
    display: block;
    text-align: center;
    margin-top: 24px;
    font-size: 14px;
    color: var(--text-muted);
    text-decoration: none;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--orange); }

  @media (max-width: 480px) {
    .login-card {
      padding: 36px 24px;
    }
  }
</style>
</head>
<body>

<div class="bg-blob"></div>
<div class="bg-blob"></div>

<div class="login-card" id="loginCard">
  <div class="login-header">
    <a href="homepage.html" class="logo">haz<span>ly</span></a>
    <p>Client Portal</p>
  </div>

  <div class="form-group">
    <label for="email">Email</label>
    <input type="email" id="email" placeholder="Enter your email address" autocomplete="email">
  </div>

  <div class="form-group">
    <label for="password">Password</label>
    <input type="password" id="password" placeholder="Enter your password" autocomplete="current-password">
  </div>

  <div class="form-options">
    <label class="remember-me">
      <input type="checkbox">
      <span>Remember me</span>
    </label>
    <a href="#" class="forgot-link" onclick="event.preventDefault();">Forgot password?</a>
  </div>

  <button class="btn-login" id="loginBtn">Sign In</button>

  <div class="error-message" id="errorMsg">Invalid credentials. Please try again.</div>

  <a href="homepage.html" class="back-link">← Back to Hazly</a>
</div>

<script>
  const loginBtn = document.getElementById('loginBtn');
  const loginCard = document.getElementById('loginCard');
  const errorMsg = document.getElementById('errorMsg');
  const emailInput = document.getElementById('email');
  const passwordInput = document.getElementById('password');

  loginBtn.addEventListener('click', () => {
    // Add error styling to inputs
    emailInput.classList.add('error');
    passwordInput.classList.add('error');

    // Show error message
    errorMsg.classList.add('show');

    // Shake the card
    loginCard.classList.remove('shake');
    void loginCard.offsetWidth; // trigger reflow for re-animation
    loginCard.classList.add('shake');

    // Remove error styling after a moment
    setTimeout(() => {
      emailInput.classList.remove('error');
      passwordInput.classList.remove('error');
    }, 2000);
  });

  // Also trigger on Enter key
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') loginBtn.click();
  });
</script>

</body>
</html>
